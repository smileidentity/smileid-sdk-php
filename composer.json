{
    "name": "smile-identity/core",
    "description": "Official Smile ID server-side SDK for PHP.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/smileidentity/smileid-sdk-php",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "friendsofphp/php-cs-fixer": "^3.0",
        "phpstan/phpstan": "^1.10"
    },
    "autoload": {
        "psr-4": {
            "SmileIdentity\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SmileIdentity\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "php-cs-fixer fix --dry-run --diff",
        "analyse": "phpstan analyse"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
