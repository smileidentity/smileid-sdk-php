{
    "name": "smileid/example-php",
    "description": "Example CLI and integration testbench for the Smile ID PHP SDK.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "smileid/smileid": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "phpstan/phpstan": "^1.10",
        "friendsofphp/php-cs-fixer": "^3.0"
    },
    "repositories": [
        {
            "type": "path",
            "url": "..",
            "options": {
                "symlink": true
            }
        }
    ],
    "autoload": {
        "psr-4": {
            "SmileIdentity\\Example\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SmileIdentity\\Example\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=1G",
        "lint": "php-cs-fixer fix --dry-run --diff"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
